{
  "name": "studyclaw-next",
  "version": "0.1.1-beta",
  "private": true,
  "type": "module",
  "description": "StudyClaw TypeScript monorepo (dsh-style: cordis + zod + storage-domain)",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json && node apps/web/node_modules/next/dist/bin/next typegen apps/web && node apps/web/node_modules/typescript/bin/tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:storage": "tsx --tsconfig tsconfig.base.json scripts/smoke-storage.ts",
    "serve": "tsx --tsconfig tsconfig.base.json apps/cli/src/bin.ts serve",
    "build": "tsc -b tsconfig.json && node scripts/sync-built-package-json.mjs",
    "build:web": "pnpm --filter web run build",
    "release:pack": "tsx --tsconfig tsconfig.base.json scripts/release/pack.ts",
    "release:verify": "tsx --tsconfig tsconfig.base.json scripts/release/verify-packed-install.ts",
    "release:publint": "tsx --tsconfig tsconfig.base.json scripts/release/publint.ts"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "publint": "^0.3.15",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "busboy": "^1.6.0"
  }
}
