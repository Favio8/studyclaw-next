{
    "name":  "@studyclaw/workspace",
    "version":  "0.1.0",
    "description":  "Durable workspace registry: uuid-keyed records, canonical-path uniqueness, manual display order (ported from dsh-workspace)",
    "license":  "MIT",
    "type":  "module",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/types/index.js"
                          },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "dependencies":  {
                         "zod":  "^4.4.3"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "workspace:^",
                             "@deepseek-ai/dsh-storage-domain":  "workspace:^"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "workspace:^",
                            "@deepseek-ai/dsh-storage":  "workspace:^",
                            "@deepseek-ai/dsh-storage-domain":  "workspace:^",
                            "@deepseek-ai/dsh-storage-json":  "workspace:^"
                        }
}