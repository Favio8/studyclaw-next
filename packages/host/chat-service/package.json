{
    "name":  "@studyclaw/chat-service",
    "version":  "0.1.0",
    "description":  "StudyClaw chat host: config.yaml/credentials resolution, dsh DeepSeekAdapter tool-client adapter, and the session/stream service wired to TutorSession",
    "license":  "MIT",
    "type":  "module",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/types/index.js"
                          },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "dependencies":  {
                         "@studyclaw/agent":  "workspace:^",
                         "@deepseek-ai/dsh-credentials":  "workspace:^",
                         "@deepseek-ai/dsh-llm":  "workspace:^",
                         "@deepseek-ai/dsh-llm-deepseek":  "workspace:^",
                         "@studyclaw/session":  "workspace:^",
                         "@studyclaw/tools":  "workspace:^",
                         "js-yaml":  "^4.1.0",
                         "@studyclaw/course-builder":  "workspace:^",
                         "@studyclaw/learning":  "workspace:^"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "workspace:^"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "workspace:^"
                        }
}