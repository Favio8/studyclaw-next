{
    "name":  "@studyclaw/directory-picker-native",
    "version":  "0.1.0",
    "description":  "Native OS directory picker for the StudyClaw host (Windows IFileOpenDialog child process; adapted from dsh directory-picker-native)",
    "license":  "MIT",
    "type":  "module",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/types/index.js"
                          },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/index.js",
                  "lib/types/**/*.d.ts"
              ],
    "dependencies":  {
                         "koffi":  "^3.1.0"
                     }
}